# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; THIS file (.env.example) is committed so teammates
# know which variables the app needs. Never put real secrets here.

# Your Anthropic API key (get one from the Anthropic Console).
ANTHROPIC_API_KEY=

# Which model to call. See the model catalog for current IDs.
LLM_MODEL=claude-sonnet-5

# Max tokens to generate per request.
MAX_TOKENS=1024
